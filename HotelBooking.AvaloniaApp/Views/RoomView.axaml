<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HotelBooking.AvaloniaApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="HotelBooking.AvaloniaApp.Views.RoomView"
             x:DataType="vm:RoomViewModel">

    <Design.DataContext>
        <vm:RoomViewModel />
    </Design.DataContext>

    <Grid>
        <!-- Loading Overlay -->
        <Panel IsVisible="{Binding IsLoading}">
            <Rectangle Fill="Black" Opacity="0.5"/>
            <ProgressBar IsIndeterminate="True" 
                        Width="100" 
                        Height="2" 
                        VerticalAlignment="Center"/>
        </Panel>

        <!-- Error Message -->
        <TextBlock Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Foreground="Red"
                 Margin="20,10"
                 VerticalAlignment="Top"/>

        <!-- Main Content -->
        <Grid Margin="20" RowDefinitions="Auto,*">
            <!-- Header and Add Room Form -->
            <Border Grid.Row="0" 
                    Background="#1a1a1a" 
                    CornerRadius="10" 
                    Padding="20"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Legg til nytt rom" 
                             FontSize="24" 
                             FontWeight="Bold" 
                             Margin="0,0,0,15"/>
                    
                    <Grid ColumnDefinitions="*,*,*,*,Auto" RowDefinitions="Auto,Auto" Margin="0,10">
                        <!-- Room Number -->
                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,0">
                            <TextBlock Text="Romnummer"
                                     Opacity="0.7"
                                     Margin="0,0,0,5"/>
                            <TextBox Text="{Binding RoomNumber}"
                                   Watermark="101"/>
                        </StackPanel>

                        <!-- Type -->
                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,10,0">
                            <TextBlock Text="Type"
                                     Opacity="0.7"
                                     Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Type}"
                                   Watermark="Single"/>
                        </StackPanel>

                        <!-- Price -->
                        <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,10,0">
                            <TextBlock Text="Pris"
                                     Opacity="0.7"
                                     Margin="0,0,0,5"/>
                            <NumericUpDown Value="{Binding Price}"
                                         Minimum="0"
                                         Maximum="10000"
                                         Increment="100"/>
                        </StackPanel>

                        <!-- Is Available -->
                        <StackPanel Grid.Column="3" Grid.Row="0" Margin="0,0,10,0">
                            <TextBlock Text="Tilgjengelig"
                                     Opacity="0.7"
                                     Margin="0,0,0,5"/>
                            <CheckBox IsChecked="{Binding IsAvailable}"/>
                        </StackPanel>

                        <!-- Add Button -->
                        <Button Grid.Column="4" 
                                Grid.Row="0"
                                Command="{Binding AddRoomCommand}"
                                Classes="accent"
                                VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource add_regular}"/>
                                <TextBlock Text="Legg til"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Room List -->
            <Border Grid.Row="1" 
                    Background="#1a1a1a" 
                    CornerRadius="10" 
                    Padding="20">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" 
                          ColumnDefinitions="*,Auto" 
                          Margin="0,0,0,15">
                        <TextBlock Grid.Column="0"
                                 Text="Rom" 
                                 FontSize="24" 
                                 FontWeight="Bold"/>
                        <Button Grid.Column="1"
                                Command="{Binding LoadRoomsCommand}"
                                Classes="accent">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource refresh_regular}"/>
                                <TextBlock Text="Oppdater"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <DataGrid Grid.Row="1"
                             ItemsSource="{Binding Rooms}"
                             AutoGenerateColumns="False"
                             IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Romnummer" 
                                              Binding="{Binding RoomNumber}"/>
                            <DataGridTextColumn Header="Type" 
                                              Binding="{Binding Type}"/>
                            <DataGridTextColumn Header="Pris" 
                                              Binding="{Binding Price}"/>
                            <DataGridCheckBoxColumn Header="Tilgjengelig" 
                                                  Binding="{Binding IsAvailable}"/>
                            <DataGridTemplateColumn Header="Handlinger">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Command="{Binding $parent[UserControl].((vm:RoomViewModel)DataContext).UpdateRoomCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="accent"
                                                    ToolTip.Tip="Lagre endringer">
                                                <PathIcon Data="{StaticResource save_regular}"/>
                                            </Button>
                                            <Button Command="{Binding $parent[UserControl].((vm:RoomViewModel)DataContext).DeleteRoomCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="error"
                                                    ToolTip.Tip="Slett rom">
                                                <PathIcon Data="{StaticResource delete_regular}"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
