<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HotelBooking.AvaloniaApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="HotelBooking.AvaloniaApp.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             x:Name="DashboardRoot">
    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,20">
            <TextBlock Text="{Binding WelcomeMessage}" FontSize="24" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="#ff4444" TextWrapping="Wrap"/>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="2" Margin="0,0,0,10"/>
            <Button Command="{Binding RefreshDashboardCommand}" Classes="accent">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource refresh_regular}"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20">

                <!-- Statistics Overview -->
                <Border Classes="card">
                    <Grid ColumnDefinitions="*,*,*,*">
                        <Border Classes="stat">
                            <StackPanel>
                                <TextBlock Text="Today's Check-ins" Classes="subtitle"/>
                                <TextBlock Text="{Binding TodayCheckIns}" Classes="stat-value"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="stat">
                            <StackPanel>
                                <TextBlock Text="Today's Check-outs" Classes="subtitle"/>
                                <TextBlock Text="{Binding TodayCheckOuts}" Classes="stat-value"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="stat">
                            <StackPanel>
                                <TextBlock Text="Available Rooms" Classes="subtitle"/>
                                <TextBlock Text="{Binding AvailableRooms}" Classes="stat-value"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Classes="stat">
                            <StackPanel>
                                <TextBlock Text="Occupancy Rate" Classes="subtitle"/>
                                <TextBlock Text="{Binding OccupancyRate, StringFormat='{}{0:P0}'}" Classes="stat-value"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Today's Bookings -->
                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Text="Today's Bookings" Classes="section-header"/>
                        <ItemsControl ItemsSource="{Binding TodaysBookings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="list-item">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="{Binding Guest.Name}" Classes="primary"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Room.RoomNumber, StringFormat='Room {0}'}" Classes="secondary"/>
                                                    <TextBlock Text="{Binding Status}" Classes="secondary"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Upcoming Bookings -->
                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Text="Upcoming Bookings" Classes="section-header"/>
                        <ItemsControl ItemsSource="{Binding UpcomingBookings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="list-item">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Guest.Name}" Classes="primary"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Room.RoomNumber, StringFormat='Room {0}'}" Classes="secondary"/>
                                                <TextBlock Text="{Binding CheckIn, StringFormat='{}{0:d}'}" Classes="secondary"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Rooms Needing Attention -->
                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Text="Rooms Needing Attention" Classes="section-header"/>
                        <ItemsControl ItemsSource="{Binding RoomsNeedingAttention}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="list-item">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="{Binding RoomNumber, StringFormat='Room {0}'}" Classes="primary"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Type}" Classes="secondary"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- Removed the Mark Cleaned Button -->
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
