<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HotelBooking.AvaloniaApp.ViewModels"
             xmlns:models="using:HotelBooking.Core.Models"
             xmlns:d="https://github.com/avaloniaui"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="HotelBooking.AvaloniaApp.Views.BookingsView"
             x:DataType="vm:BookingsViewModel"
             d:DesignWidth="800"
             d:DesignHeight="600">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <StackPanel Margin="20">
            <TextBlock Text="Bookings"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="Red"/>

            <TextBlock Text="{Binding SuccessMessage}"
                       IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="Green"/>

            <ProgressBar IsIndeterminate="True"
                         IsVisible="{Binding IsLoading}"
                         Height="4"
                         Margin="0,10,0,10"/>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="New Booking"
                        Command="{Binding ShowNewBookingDialogCommand}"/>
                <Button Content="Update Booking"
                        Command="{Binding UpdateBookingCommand}"
                        IsEnabled="{Binding SelectedBooking, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <Button Content="Cancel Booking"
                        Command="{Binding DeleteBookingCommand}"
                        IsEnabled="{Binding SelectedBooking, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </StackPanel>

        <!-- Bookings List -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Bookings}"
                  SelectedItem="{Binding SelectedBooking}"
                  AutoGenerateColumns="False"
                  Margin="20"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding BookingId}"/>
                <DataGridTextColumn Header="Guest" Binding="{Binding Guest.Name}"/>
                <DataGridTextColumn Header="Room" Binding="{Binding Room.RoomNumber}"/>
                <DataGridTextColumn Header="Check In" Binding="{Binding CheckIn, StringFormat={}{0:dd.MM.yyyy}}"/>
                <DataGridTextColumn Header="Check Out" Binding="{Binding CheckOut, StringFormat={}{0:dd.MM.yyyy}}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- New Booking Dialog -->
        <Grid Grid.Row="2"
              IsVisible="{Binding IsNewBookingDialogOpen}"
              Background="#80000000">
            <Border Background="White"
                    Padding="20"
                    Width="400"
                    CornerRadius="10"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="10">
                    <TextBlock Text="New Booking" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                    <TextBlock Text="Guest"/>
                    <ComboBox ItemsSource="{Binding Guests}"
                              SelectedItem="{Binding SelectedGuest}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Room"/>
                    <ComboBox ItemsSource="{Binding AvailableRooms}"
                              SelectedItem="{Binding SelectedRoom}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RoomNumber}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Check In"/>
                    <DatePicker SelectedDate="{Binding SelectedBooking.CheckIn, Mode=TwoWay}"/>

                    <TextBlock Text="Check Out"/>
                    <DatePicker SelectedDate="{Binding SelectedBooking.CheckOut, Mode=TwoWay}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="Cancel" Command="{Binding CloseNewBookingDialog}"/>
                        <Button Content="Create" Command="{Binding CreateBooking}"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
