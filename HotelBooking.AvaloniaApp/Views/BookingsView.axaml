<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HotelBooking.AvaloniaApp.ViewModels"
             xmlns:models="using:HotelBooking.Core.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="HotelBooking.AvaloniaApp.Views.BookingsView"
             x:DataType="vm:BookingsViewModel"
             d:DesignWidth="800"
             d:DesignHeight="600">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <StackPanel Margin="20">
            <TextBlock Text="Bookinger"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="Red"/>

            <TextBlock Text="{Binding SuccessMessage}"
                       IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="Green"/>

            <ProgressBar IsIndeterminate="True"
                         IsVisible="{Binding IsLoading}"
                         Height="4"
                         Margin="0,10,0,10"/>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Ny Booking"
                        Command="{Binding ShowNewBookingDialogCommand}"/>
                <Button Content="Oppdater Booking"
                        Command="{Binding UpdateBookingCommand}"
                        IsEnabled="{Binding SelectedBooking, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <Button Content="Kanseller Booking"
                        Command="{Binding DeleteBookingCommand}"
                        IsEnabled="{Binding SelectedBooking, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </StackPanel>

        <!-- Bookings List -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Bookings}"
                  SelectedItem="{Binding SelectedBooking}"
                  AutoGenerateColumns="False"
                  Margin="20"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding BookingId}"/>
                <DataGridTextColumn Header="Gjest" Binding="{Binding Guest.Name}"/>
                <DataGridTextColumn Header="Rom" Binding="{Binding Room.RoomNumber}"/>
                <DataGridTextColumn Header="Innsjekking" Binding="{Binding CheckIn, StringFormat={}{0:dd.MM.yyyy}}"/>
                <DataGridTextColumn Header="Utsjekking" Binding="{Binding CheckOut, StringFormat={}{0:dd.MM.yyyy}}"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- New Booking Dialog -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              IsVisible="{Binding IsNewBookingDialogOpen}">
            <Border Background="#80000000"/>
            <Border Background="#2d2d2d"
                    Padding="20"
                    Width="400"
                    CornerRadius="10"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="10">
                    <TextBlock Text="Ny Booking" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                    <TextBlock Text="Gjest"/>
                    <ComboBox ItemsSource="{Binding Guests}"
                              SelectedItem="{Binding SelectedGuest}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Rom"/>
                    <ComboBox ItemsSource="{Binding AvailableRooms}"
                              SelectedItem="{Binding SelectedRoom}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RoomNumber}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Innsjekking"/>
                    <DatePicker SelectedDate="{Binding NewBooking.CheckIn}"
                              HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Utsjekking"/>
                    <DatePicker SelectedDate="{Binding NewBooking.CheckOut}"
                              HorizontalAlignment="Stretch"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                        <Button Content="Avbryt" Command="{Binding CancelNewBookingCommand}"/>
                        <Button Content="Lagre" Command="{Binding SaveNewBookingCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
