<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HotelBooking.AvaloniaApp.ViewModels"
             xmlns:views="using:HotelBooking.AvaloniaApp.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="HotelBooking.AvaloniaApp.Views.MainView"
             x:DataType="vm:MainWindowViewModel">
    <Grid>
        <SplitView IsPaneOpen="{Binding IsPaneOpen}"
                   DisplayMode="CompactInline"
                   OpenPaneLength="250"
                   CompactPaneLength="48">
            <SplitView.Pane>
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Menu Toggle Button -->
                    <Button Grid.Row="0"
                            Command="{Binding TogglePaneCommand}"
                            Width="48" Height="48"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                        <PathIcon Data="{StaticResource menu_regular}"/>
                    </Button>

                    <!-- Navigation Menu -->
                    <StackPanel Grid.Row="1" Spacing="5" Margin="0,48,0,0">
                        <!-- Receptionist Features -->
                        <Button Command="{Binding NavigateToCommand}"
                                CommandParameter="dashboard"
                                Classes="navButton">
                            <StackPanel Orientation="Horizontal">
                                <PathIcon Data="{StaticResource home_regular}"/>
                                <TextBlock Text="Dashboard"
                                         Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToCommand}"
                                CommandParameter="bookings"
                                Classes="navButton">
                            <StackPanel Orientation="Horizontal">
                                <PathIcon Data="{StaticResource calendar_regular}"/>
                                <TextBlock Text="Bookings"
                                         Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToCommand}"
                                CommandParameter="events"
                                Classes="navButton">
                            <StackPanel Orientation="Horizontal">
                                <PathIcon Data="{StaticResource calendar_star_regular}"/>
                                <TextBlock Text="Events"
                                         Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Administrator Features -->
                        <StackPanel IsVisible="{Binding IsAdmin}">
                            <Separator Margin="0,10"/>
                            <TextBlock Text="Administrator"
                                     Margin="12,5"
                                     Foreground="Gray"/>

                            <Button Command="{Binding NavigateToCommand}"
                                    CommandParameter="rooms"
                                    Classes="navButton">
                                <StackPanel Orientation="Horizontal">
                                    <PathIcon Data="{StaticResource building_regular}"/>
                                    <TextBlock Text="Room Management"
                                             Margin="12,0,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateToCommand}"
                                    CommandParameter="backup"
                                    Classes="navButton">
                                <StackPanel Orientation="Horizontal">
                                    <PathIcon Data="{StaticResource archive_regular}"/>
                                    <TextBlock Text="Backup/Restore"
                                             Margin="12,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Role Toggle -->
                    <ToggleButton Grid.Row="2"
                                 IsChecked="{Binding IsAdmin}"
                                 Margin="5,10"
                                 HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <PathIcon Data="{StaticResource person_regular}"/>
                            <TextBlock Text="{Binding IsAdmin, Converter={StaticResource RoleTextConverter}}"
                                     Margin="12,0,0,0"/>
                        </StackPanel>
                    </ToggleButton>
                </Grid>
            </SplitView.Pane>

            <!-- Content Area -->
            <Panel>
                <views:DashboardView IsVisible="{Binding CurrentView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=dashboard}"/>
                <views:BookingsView IsVisible="{Binding CurrentView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=bookings}"/>
                <views:RoomManagementView IsVisible="{Binding CurrentView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=rooms}"/>
                <views:EventView IsVisible="{Binding CurrentView, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=events}"/>
            </Panel>
        </SplitView>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.navButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        
        <Style Selector="Button.navButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3d3d3d"/>
        </Style>
        
        <Style Selector="PathIcon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>
    </UserControl.Styles>
</UserControl>