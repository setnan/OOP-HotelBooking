<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HotelBooking.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="HotelBooking.Desktop.Views.ReservationView"
             x:DataType="vm:ReservationViewModel">
    <StackPanel>
        <TextBlock Text="{Binding Title}"
                 FontSize="24"
                 FontWeight="Bold"
                 Margin="0,0,0,20"
                 Foreground="White"/>
        
        <!-- Reservation form will go here -->
        <TextBlock Text="Reservation form will be displayed here"
                 FontSize="18"
                 Foreground="White"/>
    </StackPanel>
</UserControl>
