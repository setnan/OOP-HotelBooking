<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HotelBooking.AvaloniaApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="HotelBooking.AvaloniaApp.Views.BookingView"
             x:DataType="vm:BookingViewModel">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Margin="20">
            <TextBlock Text="Bookings"
                     FontSize="24"
                     FontWeight="Bold"
                     Margin="0,0,0,20"/>

            <!-- Error/Success Messages -->
            <TextBlock Text="{Binding ErrorMessage}"
                     IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Foreground="Red"
                     Margin="0,0,0,10"/>
            <TextBlock Text="{Binding SuccessMessage}"
                     IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Foreground="Green"
                     Margin="0,0,0,10"/>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True"
                       IsVisible="{Binding IsLoading}"
                       Margin="0,0,0,10"/>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
                <Button Content="New Booking"
                       Command="{Binding ShowNewBookingDialogCommand}"/>
                <Button Content="Update Booking"
                       Command="{Binding UpdateBookingCommand}"
                       IsEnabled="{Binding SelectedBooking, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <Button Content="Cancel Booking"
                       Command="{Binding CancelBookingCommand}"
                       IsEnabled="{Binding SelectedBooking, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>

            <!-- Bookings List -->
            <DataGrid ItemsSource="{Binding Bookings}"
                    SelectedItem="{Binding SelectedBooking}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    Height="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Booking ID" Binding="{Binding BookingId}"/>
                    <DataGridTextColumn Header="Guest" Binding="{Binding Guest.Name}"/>
                    <DataGridTextColumn Header="Room" Binding="{Binding Room.Number}"/>
                    <DataGridTextColumn Header="Check In" Binding="{Binding CheckIn, StringFormat={}{0:d}}"/>
                    <DataGridTextColumn Header="Check Out" Binding="{Binding CheckOut, StringFormat={}{0:d}}"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <!-- New Booking Dialog -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
             IsVisible="{Binding IsNewBookingDialogOpen}"
             Background="#80000000">
            <Border Background="#1e1e1e"
                    CornerRadius="8"
                    Width="400"
                    Padding="20"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    BoxShadow="0 4 8 0 #40000000">
                <StackPanel>
                    <TextBlock Text="New Booking"
                             FontSize="20"
                             FontWeight="Bold"
                             Margin="0,0,0,20"/>

                    <!-- Room Selection -->
                    <TextBlock Text="Room:"/>
                    <ComboBox ItemsSource="{Binding AvailableRooms}"
                            SelectedItem="{Binding SelectedRoom}"
                            Width="300"
                            Margin="0,0,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Number}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Guest Selection -->
                    <TextBlock Text="Guest:"/>
                    <ComboBox ItemsSource="{Binding Guests}"
                            SelectedItem="{Binding SelectedGuest}"
                            Width="300"
                            Margin="0,0,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Check In/Out Dates -->
                    <TextBlock Text="Check In:"/>
                    <CalendarDatePicker SelectedDate="{Binding CheckIn}"
                                     Width="300"
                                     Margin="0,0,0,10"/>

                    <TextBlock Text="Check Out:"/>
                    <CalendarDatePicker SelectedDate="{Binding CheckOut}"
                                     Width="300"
                                     Margin="0,0,0,20"/>

                    <!-- Dialog Actions -->
                    <StackPanel Orientation="Horizontal"
                              HorizontalAlignment="Right"
                              Spacing="10">
                        <Button Content="Cancel"
                               Command="{Binding !IsNewBookingDialogOpen}"/>
                        <Button Content="Create"
                               Command="{Binding CreateBookingCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
