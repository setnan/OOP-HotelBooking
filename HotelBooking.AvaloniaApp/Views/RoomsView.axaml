<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HotelBooking.AvaloniaApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="HotelBooking.AvaloniaApp.Views.RoomsView"
             x:DataType="vm:RoomsViewModel">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Spacing="10">
            <TextBlock Text="{Binding Title}"
                     FontSize="24"
                     FontWeight="Bold"
                     Margin="0,0,0,20"
                     Foreground="White"/>
            
            <!-- Loading indicator -->
            <ProgressBar IsIndeterminate="True"
                       IsVisible="{Binding IsLoading}"
                       Height="2"
                       Margin="0,0,0,10"/>
        </StackPanel>

        <!-- Rooms grid -->
        <ScrollViewer Grid.Row="1" Margin="0,10,0,0">
            <ItemsControl ItemsSource="{Binding Rooms}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2d2d2d"
                                BorderBrush="#3d3d3d"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="5"
                                Padding="15"
                                Width="250">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding RoomNumber}"
                                         FontSize="18"
                                         FontWeight="Bold"
                                         Foreground="White"/>
                                <TextBlock Text="{Binding Type}"
                                         Foreground="LightGray"/>
                                <TextBlock Text="{Binding Price, StringFormat='${0:N2}/night'}"
                                         Foreground="#00cc66"
                                         FontWeight="SemiBold"/>
                                <Button Content="Book Now"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Classes="accent"
                                        IsEnabled="{Binding IsAvailable}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
