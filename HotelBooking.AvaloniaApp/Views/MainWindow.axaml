<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HotelBooking.AvaloniaApp.ViewModels"
        xmlns:views="clr-namespace:HotelBooking.AvaloniaApp.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="HotelBooking.AvaloniaApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/favicon.png"
        Title="Gokstad Hotel"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen"
        Width="1200"
        Height="800">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_ButtonBackground"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Padding="{TemplateBinding Padding}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ Border#PART_ButtonBackground">
            <Setter Property="Background" Value="#3a3a3a"/>
        </Style>
        <Style Selector="Button.nav:pressed /template/ Border#PART_ButtonBackground">
            <Setter Property="Background" Value="#4a4a4a"/>
        </Style>
        <Style Selector="Button.nav:focus /template/ Border#PART_ButtonBackground">
            <Setter Property="Background" Value="#3a3a3a"/>
        </Style>
    </Window.Styles>

    <Panel>
        <!-- Background with blur -->
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="Black"
                    TintOpacity="1"
                    MaterialOpacity="0.65" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <!-- Main Content -->
        <DockPanel Margin="0,30,0,0">
            <!-- Navigation Menu -->
            <Border DockPanel.Dock="Left" 
                    Background="#1a1a1a" 
                    Width="200" 
                    Padding="10">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" 
                              Spacing="10" 
                              Margin="0,0,0,20">
                        <Image Source="/Assets/favicon.png" 
                               Width="24" 
                               Height="24"/>
                        <TextBlock Text="Gokstad Hotel"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 Foreground="White"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Content="Dashboard"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="dashboard"
                            HorizontalAlignment="Stretch"
                            Height="40"
                            Classes="nav"/>

                    <Button Content="Bookinger"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="bookings"
                            HorizontalAlignment="Stretch"
                            Height="40"
                            Classes="nav"/>

                    <Button Content="Gjester"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="guests"
                            HorizontalAlignment="Stretch"
                            Height="40"
                            Classes="nav"/>

                    <Button Content="Rom"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="rooms"
                            HorizontalAlignment="Stretch"
                            Height="40"
                            Classes="nav"/>

                    <Button Content="Klienter"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="clients"
                            HorizontalAlignment="Stretch"
                            Height="40"
                            Classes="nav"/>

                    <Button Content="Event"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="events"
                            HorizontalAlignment="Stretch"
                            Height="40"
                            Classes="nav"/>
                </StackPanel>
            </Border>

            <!-- Content Area -->
            <Border Background="#2d2d2d" 
                    Margin="0"
                    Padding="20">
                <ContentControl Content="{Binding CurrentView}"/>
            </Border>
        </DockPanel>
    </Panel>
</Window>