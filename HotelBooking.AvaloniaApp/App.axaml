<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:HotelBooking.AvaloniaApp"
             xmlns:converters="using:HotelBooking.AvaloniaApp.Converters"
             x:Class="HotelBooking.AvaloniaApp.App"
             RequestedThemeVariant="Dark">
             <!-- "Dark" ThemeVariant follows system theme variant. "Default" or "Light" are other available options. -->

    <Application.Resources>
        <converters:RoleTextConverter x:Key="RoleTextConverter"/>
        <converters:BookingStatusColorConverter x:Key="BookingStatusColorConverter"/>
        <converters:BookingStatusCancelableConverter x:Key="BookingStatusCancelableConverter"/>
        <converters:StatusToVisibilityConverter x:Key="StatusToVisibilityConverter"/>
        
        <!-- Icons -->
        <StreamGeometry x:Key="refresh_regular">M11.9951 3C7.57403 3 4 6.58526 4 11C4 15.4147 7.57403 19 11.9951 19C15.6894 19 18.8352 16.3804 19.7381 12.8909L19.9405 12H18.4429H17.4429L17.2891 12.5898C16.5705 15.2837 14.4804 17.25 11.9951 17.25C8.52714 17.25 5.75 14.4647 5.75 11C5.75 7.53526 8.52714 4.75 11.9951 4.75C13.3627 4.75 14.618 5.21685 15.6346 5.99949L13.25 8.38397H19.25V2.38397L17.0214 4.61252C15.6831 3.60193 13.9128 3 11.9951 3Z</StreamGeometry>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        
        <!-- Common Styles -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="#7E429A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15,8"/>
        </Style>
        
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#5C3070"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#3d3d3d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style Selector="DataGrid">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3d3d3d"/>
        </Style>

        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="#2d2d2d"/>
        </Style>

        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="#3d3d3d"/>
        </Style>

        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="#0078D4"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#3d3d3d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Application.Styles>
</Application>